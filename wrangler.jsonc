{
  // Statische site: Cloudflare serveert de map dist/ (gebouwd met `npm run build`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uit-de-pluktuin",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Nodig voor de testbuilds van andere branches dan main (Workers Builds draait daar `wrangler preview`)
  "previews": {}
}
