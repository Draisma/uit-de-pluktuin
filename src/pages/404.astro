---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
---
<Base titel="Niet gevonden">
  <div class="wrap niet-gevonden">
    <figure><Foto id="leeg-bed" alt="Een vers geharkt, nog leeg moestuinbed met een blanco plantenlabel" eager sizes="(max-width: 760px) 100vw, 380px" /></figure>
    <div>
      <p class="kapitaal">404</p>
      <h1>Dit bed is nog niet ingezaaid</h1>
      <p>Deze pagina bestaat niet (meer). Probeer de <a href="/inhoud/">inhoud</a> of <a href="/zoeken/">zoek een recept</a>.</p>
    </div>
  </div>
</Base>
<style>
  .niet-gevonden { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 520px); gap: clamp(28px, 6vw, 64px); align-items: center; justify-content: center; padding: 72px 0; }
  figure { margin: 0; border-radius: 4px; overflow: hidden; }
  figure :global(img) { display: block; width: 100%; height: auto; }
  h1 { font-size: clamp(36px, 5vw, 48px); margin: 12px 0 16px; }
  @media (max-width: 760px) { .niet-gevonden { grid-template-columns: 1fr; padding: 24px 0 48px; text-align: center; } figure { max-width: 360px; margin: 0 auto; } }
</style>
