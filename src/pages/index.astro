---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { boek, hoofdstukken, inhoud, recepten } from '../lib/data.js';
---
<Base>
  <section class="hero wrap">
    <div class="omslag">
      <Foto id="omslag" alt="Verse oogst uit de pluktuin op een groene houten tafel" eager sizes="(max-width: 860px) 100vw, 520px" />
      <div class="omslag-tekst">
        <span class="kapitaal">Seizoenskookboek 2026</span>
        <span class="omslag-titel">Uit de<br />pluktuin</span>
        <span class="omslag-sub">Recepten met de wekelijkse oogst<br />van De Gagelgaard</span>
      </div>
    </div>
    <div class="hero-tekst">
      <span class="kapitaal">Seizoenskookboek 2026</span>
      <h1>Groente in de hoofdrol</h1>
      <p class="lead">{boek.voorwoord.lead}</p>
      <p>{boek.voorwoord.alineas[0]}</p>
      <ul class="cijfers">
        <li><strong>{recepten.length}</strong> recepten</li>
        <li><strong>{hoofdstukken.length}</strong> hoofdstukken</li>
        <li><strong>2</strong> eetclubmenu's</li>
      </ul>
      <p class="knoppen">
        <a class="knop" href="/inhoud/">Bekijk de inhoud</a>
        <a class="knop knop-stil" href="/voorwoord/">Lees het voorwoord</a>
        <a class="knop knop-stil" href="/kookboek.pdf" download="Uit de pluktuin 2026.pdf">Download als pdf</a>
      </p>
    </div>
  </section>

  <section class="wrap hoofdstukken" aria-labelledby="hs">
    <h2 id="hs" class="kapitaal sectiekop">De hoofdstukken</h2>
    <ol class="hs-lijst">
      {hoofdstukken.map((h) => (
        <li data-hoofdstuk={h.slug}>
          <a href={`/${h.slug}/`}>
            <figure><Foto id={h.foto} alt="" sizes="(max-width: 560px) 100vw, (max-width: 1000px) 33vw, 220px" /></figure>
            <span class="kapitaal">Hoofdstuk {h.nummer}</span>
            <h3>{h.titel}</h3>
            <p>{h.periode}<span class="aantal"> · {inhoud(h.slug).length} {h.slug === 'eetclub' ? 'pagina’s' : 'recepten'}</span></p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; padding-top: 48px; padding-bottom: 24px; }
  .omslag { position: relative; border-radius: 4px; overflow: hidden; box-shadow: 0 30px 60px -30px rgb(43 38 34 / 0.45); }
  .omslag :global(img) { width: 100%; height: auto; }
  .omslag-tekst { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #fff; padding: 0 18%; }
  .omslag-tekst .kapitaal { color: #fff; font-size: 10px; margin-bottom: 14px; }
  .omslag-titel { font-family: var(--display); font-weight: 600; font-size: clamp(44px, 7vw, 64px); line-height: 0.98; text-shadow: 0 2px 18px rgb(0 0 0 / 0.35); }
  .omslag-sub { font-style: italic; margin-top: 18px; font-size: 15px; line-height: 1.45; text-shadow: 0 1px 10px rgb(0 0 0 / 0.5); }
  .hero-tekst h1 { font-size: clamp(36px, 5vw, 56px); margin: 14px 0 22px; }
  .lead { font-size: 21px; font-style: italic; color: var(--inkt-2); line-height: 1.5; }
  .cijfers { display: flex; gap: 28px; list-style: none; padding: 0; margin: 28px 0; font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gedempt); }
  .cijfers strong { display: block; font-family: var(--display); font-size: 34px; letter-spacing: 0; color: var(--inkt); font-weight: 500; line-height: 1.1; }
  .knoppen { display: flex; gap: 10px; flex-wrap: wrap; }
  .knop-stil { border-color: var(--lijn); }
  .sectiekop { color: var(--gedempt); margin: 72px 0 24px; border-top: 1px solid var(--lijn); padding-top: 24px; }
  .hs-lijst { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .hs-lijst a { text-decoration: none; display: block; }
  .hs-lijst figure { margin: 0 0 14px; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 4px; border-top: 6px solid var(--kleur); }
  .hs-lijst :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .hs-lijst a:hover :global(img) { transform: scale(1.03); }
  .hs-lijst h3 { font-size: 26px; margin: 6px 0 4px; }
  .hs-lijst p { font-style: italic; color: var(--gedempt); font-size: 15px; margin: 0; }
  .aantal { font-style: normal; font-family: var(--sans); font-size: 12px; }
  @media (max-width: 1000px) { .hs-lijst { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 24px; }
    .hero-tekst > .kapitaal { display: none; }
  }
  @media (max-width: 560px) { .hs-lijst { grid-template-columns: repeat(2, 1fr); gap: 24px 14px; } .hs-lijst h3 { font-size: 21px; } }
</style>
