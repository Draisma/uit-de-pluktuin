---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { boek } from '../lib/data.js';
const v = boek.voorwoord;
---
<Base titel="Voorwoord" beschrijving={v.lead}>
  <article class="wrap voorwoord">
    <figure><Foto id={v.foto} alt="" eager vergroot sizes="(max-width: 860px) 100vw, 420px" /></figure>
    <div>
      <span class="kapitaal">Voorwoord</span>
      <h1>{v.titel}</h1>
      <p class="lead">{v.lead}</p>
      {v.alineas.map((a) => <p>{a}</p>)}
      <h2 class="kapitaal">Zo lees je de recepten</h2>
      <ul>{v.zo_lees_je.map((z) => <li>{z}</li>)}</ul>
      <p class="slot">{v.slot}</p>
    </div>
  </article>
</Base>
<style>
  .voorwoord { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 640px); gap: clamp(28px, 6vw, 72px); padding-top: 48px; align-items: start; }
  figure { margin: 0; border-radius: 4px; overflow: hidden; position: sticky; top: 24px; }
  h1 { font-size: clamp(38px, 5vw, 54px); margin: 12px 0 20px; }
  .lead { font-size: 21px; font-style: italic; color: var(--inkt-2); }
  h2 { margin: 36px 0 12px; }
  ul { padding-left: 20px; }
  li { margin-bottom: 8px; }
  .slot { font-family: var(--hand); font-size: 34px; color: var(--kleur); margin-top: 28px; }
  @media (max-width: 860px) { .voorwoord { grid-template-columns: 1fr; padding-top: 24px; } figure { position: static; aspect-ratio: 16/10; } figure :global(img) { width: 100%; height: 100%; object-fit: cover; } }
</style>
